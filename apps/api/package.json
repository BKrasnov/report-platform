{
  "name": "@report-platform/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "pnpm exec nest start --watch",
    "start:prod": "node dist/main.js",
    "start:worker:dev": "pnpm exec nest start --watch --entryFile worker",
    "start:worker:prod": "node dist/worker.js",
    "build": "pnpm exec nest build",
    "lint": "pnpm exec tsc -p tsconfig.json --noEmit",
    "test": "pnpm exec vitest run",
    "db:migrate": "pnpm exec typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "db:seed": "pnpm exec ts-node src/seed/seed.ts",
    "db:init": "pnpm run db:migrate && pnpm run db:seed"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/typeorm": "^10.0.2",
    "@report-platform/shared": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.15.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.13.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5",
    "vitest": "^2.1.8"
  }
}
